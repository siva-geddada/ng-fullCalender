    "directory": "projects/ng-fullcalender"
  },
  "bugs": {
    "url": "https://github.com/siva-geddada/ng-fullCalender/issues"
  },
  "peerDependencies": {
    "@angular/common": ">=22.0.0",
    "@angular/core": ">=22.0.0"
  },
  "dependencies": {
